cat > .gitignore <<'EOF'
# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
*.tfplan.*
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files - may contain secrets
*.tfvars
*.tfvars.json

# OS / Editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
EOF